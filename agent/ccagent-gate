#!/usr/bin/env bash
# Forced command for the Control Center key. Only these verbs are accepted.
umask 077
CONF=${CCAGENT_CONF:-/etc/ccagent.conf}
DIR=/var/lib/ccagent; [ -r "$CONF" ] && . "$CONF"
LOG=$DIR/metrics.jsonl
POWER_UNIT=${POWER_UNIT:-/etc/systemd/system/ccagent-power.path}
set -- $SSH_ORIGINAL_COMMAND
verb=${1:-}
case "$verb" in
  read)
    [ -s "$LOG" ] && mv "$LOG" "$DIR/metrics.$(date +%s%N).reading"
    shopt -s nullglob
    for f in "$DIR"/metrics.*.reading; do b=${f##*/}; echo "#F $b"; cat "$f"; done
    echo "#END" ;;
  ack)
    [[ "${2:-}" =~ ^metrics\.[0-9]+\.reading$ ]] || { echo "bad ack" >&2; exit 2; }
    n=${2#metrics.}; n=${n%.reading}
    shopt -s nullglob
    for f in "$DIR"/metrics.*.reading; do b=${f##*/}; m=${b#metrics.}; m=${m%.reading}; [ "$m" -le "$n" ] && rm -f "$f"; done
    echo ok ;;
  info) cat "$DIR/static.json" ;;
  power-off|reboot)
    # No sudo needed: drop a request file; a root-owned systemd path unit picks it up and runs the matching action.
    [ -f "$POWER_UNIT" ] || { echo "power control not installed on this unit: re-run the installer to enable it" >&2; exit 3; }
    if [ "$verb" = power-off ]; then act=poweroff; else act=reboot; fi
    printf '%s\n' "$act" > "$DIR/power.request" && echo ok ;;
  *) echo "denied" >&2; exit 2 ;;
esac
